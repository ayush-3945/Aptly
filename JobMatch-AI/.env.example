# ==============================================================================
# Aptly.AI - Environment Configuration Template
# Copy this file to .env and configure with your credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Web Client URL for CORS Whitelisting (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173,http://localhost:3000,https://aptly-zeta.vercel.app

# JSON Web Token Secret (Required - server will refuse to start without this)
# Generate a secure 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# MongoDB Atlas Database Connection String (Optional for offline demo mode)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/aptly?retryWrites=true&w=majority

# Google Gemini API Key (Required for live AI inference; heuristic fallback used if missing)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Transactional Email Service via Resend (Optional - simulated in console if omitted)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=Aptly.AI <onboarding@resend.dev>

# Application Base URL (for email links and redirects)
APP_URL=http://localhost:5173
